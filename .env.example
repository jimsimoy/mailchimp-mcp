# ---------------------------------------------------------------------------
# Mailchimp MCP — copy to .env and fill in. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# Marketing API key. Format: <key>-<datacenter>, e.g. abc123...def-us13
# Create one at: https://admin.mailchimp.com/account/api/
# Use an account/user role with the least privilege you can live with.
MAILCHIMP_API_KEY=

# Optional. The datacenter is normally read from the key's "-usX" suffix.
# Set this only if your key has no suffix (e.g. an OAuth token).
# MAILCHIMP_DC=us13

# Optional. An audience (list) ID used when a tool's list_id argument is omitted.
# Find it in Mailchimp: Audience > Settings > Audience name and defaults.
# MAILCHIMP_DEFAULT_LIST_ID=

# Optional. Enables the two read-only Transactional (Mandrill) tools.
# Leave blank to keep the transactional surface disabled entirely.
# MAILCHIMP_TRANSACTIONAL_API_KEY=

# Optional. Where status snapshots are written. Default: ./snapshots
# Snapshots contain subscriber email addresses — keep them off shared disks.
# MAILCHIMP_SNAPSHOT_DIR=./snapshots

# Optional. Per-request timeout in seconds (Mailchimp's own limit is 120).
# MAILCHIMP_TIMEOUT=30

# Optional. Safety cap on records any single auto-paginating tool will pull.
# MAILCHIMP_MAX_RECORDS=5000
